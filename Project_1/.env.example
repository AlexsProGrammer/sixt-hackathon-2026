# Copy to .env (git-ignored). Default endpoint, key, and model:
# (LLM_BASE_URL_DEFAULT / LLM_API_KEY_DEFAULT / LLM_MODEL_DEFAULT are also accepted as aliases)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional max chunk size in characters (if unset, uses the code default: 45000 for text, model max_context_chars for CUAD).
# Useful for models with low TPM limits (e.g. 35000 chars ~ 9k tokens). Per-role overrides fall back to LLM_CHUNK_CHARS.
LLM_CHUNK_CHARS=

# Optional model roles (default: LLM_MODEL) and optional per-role endpoint/key/chunk overrides.
# If LLM_BASE_URL_<ROLE>, LLM_API_KEY_<ROLE>, or LLM_CHUNK_CHARS_<ROLE> is empty/unset, the default above is used.
# Capabilities per model live in models.json (refresh with tools/probe_models.py).
LLM_MODEL_A=
LLM_BASE_URL_A=
LLM_API_KEY_A=
LLM_CHUNK_CHARS_A=

LLM_MODEL_B=
LLM_BASE_URL_B=
LLM_API_KEY_B=
LLM_CHUNK_CHARS_B=

LLM_MODEL_C=
LLM_BASE_URL_C=
LLM_API_KEY_C=
LLM_CHUNK_CHARS_C=

LLM_MODEL_OCR=
LLM_BASE_URL_OCR=
LLM_API_KEY_OCR=

# Rate Limits (optional)
LLM_MIN_INTERVAL_S=4
LLM_MAX_RETRIES=5
LLM_WAIT_BUDGET_S=180
LLM_JSON_MODE=1
